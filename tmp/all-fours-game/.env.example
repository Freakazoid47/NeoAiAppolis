# Environment
NODE_ENV=development
DEBUG=false

# Server Configuration
PORT=3000
HOST=0.0.0.0
SOCKET_IO_CORS_ORIGIN=http://localhost:3000

# Game Settings
GAME_WIN_SCORE=11
PARTNERSHIP_WIN_SCORE=14
MAX_PLAYERS=4

# Optional: Database Configuration (for future features)
# DATABASE_URL=mongodb://localhost:27017/all-fours
# or for PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/all-fours

# Optional: Analytics (for future features)
# ANALYTICS_ENABLED=false
# ANALYTICS_KEY=your_key_here

# Optional: Email Notifications (for future features)
# EMAIL_SERVICE=gmail
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASSWORD=your_password

# API Configuration
API_BASE_URL=https://yourdomain.com
SOCKET_ORIGIN=https://yourdomain.com

# Authentication (when you add it)
JWT_SECRET=your-super-secret-jwt-key-change-this
SESSION_SECRET=your-super-secret-session-key-change-this

# Third-party Services
# SENTRY_DSN=https://your-sentry-url
# SENDGRID_API_KEY=your-sendgrid-key
# STRIPE_SECRET_KEY=your-stripe-key

# Logging
LOG_LEVEL=info

# Feature Flags
ENABLE_REGISTRATION=true
ENABLE_SOCIAL_LOGIN=false
MAINTENANCE_MODE=false
